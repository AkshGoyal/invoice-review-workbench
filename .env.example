# Copy to .env (git-ignored) and fill in locally. Never commit real values.

# Model access goes through OpenRouter (see docs/BUILD_STATUS.md decision 11).
MODEL_PROVIDER=openrouter
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Extraction model (OpenRouter ID). OCR runs via OpenRouter's file-parser plugin, engine mistral-ocr.
EXTRACT_MODEL=mistralai/mistral-small-2603
OCR_ENGINE=mistral-ocr
# Model that receives the OCR call; its reply is discarded (max_tokens kept minimal).
OCR_CARRIER_MODEL=mistralai/mistral-small-2603

# Runtime storage (SQLite DB, source PDFs, model artifacts). /var/data on the host.
WORKBENCH_DATA_DIR=./var

# Demo access code for the hosted app (Phase 5).
DEMO_ACCESS_CODE=change-me
